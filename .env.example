# TeamFlow production env.  ./scripts/deploy.sh generates all secrets for you; this file documents them.
# Never commit .env.

# Your domain (DNS A record -> VPS IP). Used by Nginx, CORS and the TLS certificate.
APP_DOMAIN=teamflow.example.com
LETSENCRYPT_EMAIL=you@example.com

# Postgres. Use HEX only (openssl rand -hex 24): characters like / + = would break the connection URL.
POSTGRES_USER=teamflow
POSTGRES_PASSWORD=CHANGE_ME_HEX_PASSWORD
POSTGRES_DB=teamflow

# API auth: 32+ random chars (openssl rand -base64 48). The app refuses to boot with a placeholder.
JWT_ACCESS_SECRET=CHANGE_ME_48RANDOM

# First admin (created once by the seed; you must change the password at first login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_TEMP_12CHARS

# Behaviour (also editable by the admin in Settings: deadline, work days, holidays)
REPORT_DEADLINE=18:00
APP_TZ=Asia/Kolkata
QUIZ_MAX_ATTEMPTS=3
# Uploads: largest single file in MB (Nginx allows up to 110). Set ACCEL_REDIRECT=false to let the API serve files itself (slower; fallback only).
MAX_UPLOAD_MB=100
ACCEL_REDIRECT=true
AUDIT_RETENTION_DAYS=365

# Backups (see scripts/backup.sh)
BACKUP_DIR=/var/backups/teamflow
BACKUP_KEEP_DAILY=14
# Off-site copy: set ONE of these, otherwise a dead VPS disk takes the backups with it.
#OFFSITE_RSYNC_TARGET=user@other-server:/backups/teamflow
#OFFSITE_RCLONE_REMOTE=myremote:teamflow-backups
# Get a message when a backup fails (Slack/Discord/ntfy webhook URL)
#ALERT_WEBHOOK_URL=
