# Local development only. Production env is the root .env (see ../../.env.example).
DATABASE_URL=postgresql://postgres:dev@localhost:5432/teamflow?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
API_PORT=4001
CORS_ORIGIN=http://localhost:3000
APP_TZ=Asia/Kolkata
REPORT_DEADLINE=18:00

# Optional email notifications. Leave SMTP_HOST empty to use in-app notifications only.
# Key events (task assigned, review decisions, tickets, password help) are emailed when set.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=notifications@example.com
# SMTP_PASS=replace-me
# SMTP_FROM="TeamFlow <notifications@example.com>"
# APP_URL=https://teamflow.example.com
